apps/pwa/public/platform.js

# The api/ tree is DELIBERATELY COMMITTED, and it used to be ignored here.
#
# Vercel's Git-integration build decides which Serverless Functions exist by
# looking at the CLONED REPOSITORY, before the build command runs. While
# these files were ignored, `api/` did not exist in the clone, so Vercel
# created zero functions — and the ten bundles scripts/build.mjs writes
# moments later were never part of the deployment. Every /api/v1/* route
# returned 404 in production. It only ever worked after somebody ran
# `vercel --prod` by hand from a machine where these files existed on disk.
#
# So they are tracked now. They are generated: run `npm run build` and commit
# the result. CI fails if what is committed does not match a fresh build
# (.github/workflows/frontend.yml), so they cannot drift silently.
#
# This is a stopgap. See docs/06-DEPLOYMENT.md §7 for the replacement —
# deploying with `vercel deploy --prebuilt` from CI, which needs no
# generated artifacts in git and no reliance on Vercel's file detection.

.vercel

# Authoring-time tooling — skills, memory, chats. Not application code
# and not something Vercel should upload or read. See .vercelignore for
# the same fence at deploy time.
.agents/
.claude/
MEMORY.md
memory/

.playwright-mcp/

# Netlify function bundles are NOT committed, unlike api/.
#
# The api/ exception above exists because Vercel detects functions from the
# cloned repo before the build runs. Netlify has no such constraint: it runs
# `npm run build` first and picks up whatever lands in netlify/functions,
# and the CLI deploy uploads the locally built copy. Committing them would
# be ~10 duplicated bundles of the same handlers already committed under
# api/, drifting independently.
netlify/functions/

# Local Netlify folder
.netlify

# Local agent tooling, not project source.
#
# These were committed as symlinks into ../../.agents/skills/, which is
# itself untracked — so every one of them dangled on a fresh clone, and the
# Netlify CLI refused to deploy because its file walker could not stat them.
# Untracked rather than deleted: they still resolve on this machine.
.claude/skills/
.netlify/

# Source specification documents, kept local by choice.
#
# The PRD, TRD, wireframe and design files are what this product is built
# FROM, and docs/09-PRD-AUDIT.md audits against them — but this repository
# is public, and publishing the full product strategy is a separate
# decision from publishing the code. They live in the working tree and are
# read from there; they are simply not committed.
Shikhon PRD v2.0*
Shikhon TRD v2.0*
Shikhon Wireframe Specification*
Shikhon Screens*

# The Claude Design mockup export the app/landing pages were built from —
# same "kept local by choice" reasoning as the spec documents above: it's
# what the product is built FROM, not the product itself, and the zips are
# multi-MB. The tokens and markup already derived from it live in
# apps/pwa/public/design/ and ARE committed.
Ata Ekta LMS Design System*.zip
_design_import/
