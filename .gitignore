# out of git.
apps/pwa/public/app.js
apps/pwa/public/sw.js

# The api/ tree is DELIBERATELY COMMITTED, and it used to be ignored here.
#
# Vercel's Git-integration build decides which Serverless Functions exist by
# looking at the CLONED REPOSITORY, before the build command runs. While
# these files were ignored, `api/` did not exist in the clone, so Vercel
# created zero functions — and the ten bundles scripts/build.mjs writes
# moments later were never part of the deployment. Every /api/v1/* route
# returned 404 in production. It only ever worked after somebody ran
# `vercel --prod` by hand from a machine where these files existed on disk.
#
# So they are tracked now. They are generated: run `npm run build` and commit
# the result. CI fails if what is committed does not match a fresh build
# (.github/workflows/frontend.yml), so they cannot drift silently.
#
# This is a stopgap. See docs/06-DEPLOYMENT.md §7 for the replacement —
# deploying with `vercel deploy --prebuilt` from CI, which needs no
# generated artifacts in git and no reliance on Vercel's file detection.

.vercel

# Authoring-time tooling — skills, memory, chats. Not application code
# and not something Vercel should upload or read. See .vercelignore for
# the same fence at deploy time.
.agents/
.claude/
MEMORY.md
memory/
