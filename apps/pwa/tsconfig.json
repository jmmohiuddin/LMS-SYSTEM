{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  // dev/ is the component gallery (scripts/build-gallery.mjs). It ships
  // nowhere, but it is the only caller that exercises every component
  // signature at once, so a type error there is a real API break.
  "include": ["src/**/*.ts", "dev/**/*.ts"],
  "exclude": ["src/sw.ts"]
}
