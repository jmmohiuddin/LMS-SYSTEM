{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/pwa/public",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/offline", "destination": "/offline.html" },
    { "source": "/api/v1/auth/:path*", "destination": "/api/v1/auth?path=:path*" },
    { "source": "/api/v1/academics/students/:resource", "destination": "/api/v1/academics/:resource" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/:path*", "destination": "/app.html" },
    { "source": "/design", "destination": "/design.html" }
  ],
  "crons": [
    { "path": "/api/v1/sms/dispatch", "schedule": "0 18 * * *" },
    { "path": "/api/v1/ops/maintenance", "schedule": "0 19 * * *" }
  ]
}
